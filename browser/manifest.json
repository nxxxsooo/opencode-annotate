{
  "manifest_version": 3,
  "name": "OpenCode Annotate",
  "version": "0.4.1",
  "description": "Annotate HTML-based page feedback, private drafts, and paired OpenCode delivery.",
  "key": "",
  "permissions": ["activeTab", "scripting", "storage", "sidePanel", "nativeMessaging"],
  "action": { "default_title": "Annotate this page", "default_icon": "icons/icon-32.png" },
  "background": { "service_worker": "worker.mjs", "type": "module" },
  "side_panel": { "default_path": "panel.html" },
  "commands": { "_execute_action": { "suggested_key": { "default": "Alt+Shift+A", "mac": "Alt+Shift+A" } } },
  "icons": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
}
