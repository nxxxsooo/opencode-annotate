{
  "name": "@nxxxsooo/opencode-annotate",
  "version": "0.9.0",
  "description": "Unofficial OpenCode plugin: annotate replies, documents and webpages, then send the feedback to the originating session.",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./tui": "./tui.ts"
  },
  "bin": {
    "agy-annotate": "./agy/cli.mjs"
  },
  "scripts": {
    "test": "node --test *.test.mjs bridge/*.test.mjs agy/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "install:bridge": "node scripts/install-bridge.mjs",
    "install:plugin": "node scripts/install-plugin.mjs",
    "test:smoke": "python3 smoke.py",
    "check": "node --check review.mjs && npm test && npm pack --dry-run",
    "prepublishOnly": "npm run check"
  },
  "files": [
    "tui.ts",
    "review.mjs",
    "theme.mjs",
    "input-source.mjs",
    "targets.mjs",
    "web-review.mjs",
    "browser",
    "bridge/native-host.mjs",
    "bridge/receiver.mjs",
    "bridge/wire.mjs",
    "agy",
    "scripts/install-bridge.mjs",
    "scripts/install-plugin.mjs",
    "scripts/migrate-page-context.mjs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.22 <3"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nxxxsooo/opencode-annotate.git"
  },
  "homepage": "https://github.com/nxxxsooo/opencode-annotate#readme",
  "bugs": {
    "url": "https://github.com/nxxxsooo/opencode-annotate/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "plannotator",
    "tui",
    "annotation",
    "markdown",
    "review"
  ],
  "publishConfig": {
    "access": "public"
  }
}
