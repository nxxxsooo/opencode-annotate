{
  "name": "@nxxxsooo/opencode-annotate",
  "version": "0.11.0",
  "description": "Unofficial OpenCode plugin: annotate replies, documents and webpages, and reference previous conversations.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./server.ts",
    "./tui": "./tui.ts"
  },
  "bin": {
    "annotate-tui": "./tui/run.mjs",
    "agy-annotate": "./agy/cli.mjs"
  },
  "scripts": {
    "build:tui": "node scripts/build-tui.mjs",
    "check:tui": "cargo fmt --manifest-path tui/Cargo.toml --all --check && cargo clippy --manifest-path tui/Cargo.toml --workspace --all-targets --locked -- -D warnings && cargo test --manifest-path tui/Cargo.toml --workspace --locked",
    "test": "node --test *.test.mjs bridge/*.test.mjs agy/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "install:bridge": "node scripts/install-bridge.mjs",
    "install:plugin": "node scripts/install-plugin.mjs",
    "test:smoke": "python3 smoke.py",
    "test:references": "python3 tests/references-smoke.py",
    "check": "node scripts/verify-tui.mjs && node --check review.mjs && npm test && npm pack --dry-run",
    "prepack": "node scripts/verify-tui.mjs",
    "prepublishOnly": "node scripts/verify-tui.mjs --all && npm run check"
  },
  "files": [
    "tui.ts",
    "tui/binary.mjs",
    "tui/run.mjs",
    "tui/bin",
    "tui/LICENSE",
    "tui/README.md",
    "server.ts",
    "session-tools.mjs",
    "server-history.mjs",
    "session-reference.mjs",
    "reference-command.mjs",
    "review.mjs",
    "auto-review.mjs",
    "configuration.mjs",
    "theme.mjs",
    "input-source.mjs",
    "targets.mjs",
    "web-review.mjs",
    "browser",
    "bridge/native-host.mjs",
    "bridge/receiver.mjs",
    "bridge/wire.mjs",
    "agy",
    "scripts/install-bridge.mjs",
    "scripts/install-plugin.mjs",
    "scripts/verify-tui.mjs",
    "scripts/migrate-page-context.mjs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.2.0 <3"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nxxxsooo/opencode-annotate.git"
  },
  "homepage": "https://github.com/nxxxsooo/opencode-annotate#readme",
  "bugs": {
    "url": "https://github.com/nxxxsooo/opencode-annotate/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "plannotator",
    "tui",
    "annotation",
    "markdown",
    "review"
  ],
  "publishConfig": {
    "access": "public"
  }
}
